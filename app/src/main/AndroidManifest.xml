<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Localisation : road trip, géofencing d'arrivée, zones de danger, mémoire parking -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Pack Ange gardien : SOS et "J'arrive bien" par SMS (fonctionne sans données mobiles) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- La téléphonie reste optionnelle : l'app fonctionne sur tablettes/ChromeOS sans SMS -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!-- Briefing météo (Open-Meteo), recherche de lieux (Photon/OSM), Wikipédia, open data radars -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Import des rendez-vous du jour depuis l'agenda du téléphone (Google Agenda inclus) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Ange gardien : service de conduite au premier plan (choc, arrivées, zones de danger) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Messagerie apaisée (opt-in) : lecture des SMS en conduite, réponse automatique -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MKCopilot">

        <!-- Déclaration Android Auto (app à templates) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.MKCopilot.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ange gardien pendant la conduite (démarré avec Android Auto) -->
        <service
            android:name=".feature.guardian.DriveGuardService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- « Accident détecté — tout va bien ? » : plein écran, même verrouillé -->
        <activity
            android:name=".feature.guardian.SosActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MKCopilot" />

        <!-- Rappel unique de stationnement (zone bleue) -->
        <receiver
            android:name=".feature.guardian.ParkingReminderReceiver"
            android:exported="false" />

        <!-- SMS entrants pendant la conduite (lecture vocale / réponse auto, opt-in) -->
        <receiver
            android:name=".feature.messaging.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Partage du carnet de voyage PDF généré dans le cache -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Service Car App Library — catégorie POI (validée pour le road trip / points d'intérêt) -->
        <service
            android:name=".car.CopilotCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
    </application>
</manifest>
